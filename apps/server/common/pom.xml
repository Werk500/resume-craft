<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.resumecraft</groupId>
        <artifactId>resume-craft-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>resumecraft-common</artifactId>
    <name>resumecraft-common</name>
    <description>共享能力层：通用响应/全局异常/安全配置/AI 抽象/文件存储（未来可下沉为基础服务依赖）</description>

    <dependencies>
        <!-- Web MVC（ApiResponse/WebConfig 等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 健康检查/监控端点（所有服务统一获得 /actuator/health） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- ORM：MyMetaObjectHandler（createTime 自动填充）依赖 MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- 3.5.9+ 分页插件(PaginationInnerInterceptor)独立到 jsqlparser 模块，需显式引入 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- 安全配置（SecurityConfig） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- JWT（JwtUtil 签名/解析，Step 3 认证下沉 common） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- OpenFeign：跨服务调用客户端接口（ResumeClient 等，Step 3） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- AI 抽象层：AiService/AiConfig/SpringAiServiceImpl -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- 响应式支持：Flux/SSE 流式输出（chatStream 依赖 reactor） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- 对象存储（预留，当前本地磁盘） -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <!--
          Kafka：topic 声明（KafkaTopicConfig）与消息体（EmbeddingTaskMessage）放在 common，
          供 resume（生产者）与 job-match（消费者）共享。

          本依赖为 compile 作用域，会传递给所有业务服务。这不影响 auth/application 等
          未配置 Kafka 的服务：KafkaAdmin 仅在存在 spring.kafka.bootstrap-servers
          或 NewTopic bean 时才生效，这些服务两者都没有，因此不会尝试连 Kafka。
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!--
          AOP 支持：Resilience4j 的 @CircuitBreaker 依赖 AspectJ 织入才能生效。

          为什么必须显式引入：resilience4j-spring6 里虽然定义了标注 @Aspect 的
          CircuitBreakerAspect，但 Spring 只有检测到 AspectJ 织入器（aspectjweaver）
          时才启用 AOP 自动代理。缺少本依赖时，@CircuitBreaker 会被静默忽略——
          注解合法、服务能启动、熔断器也注册了，但调用完全不被拦截。
          这是最难排查的一类问题：没有任何报错。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!--
  Nacos 配置中心。
  与 nacos-discovery 分开：discovery 负责"服务在哪"，config 负责"服务怎么配"。
  版本由 spring-cloud-alibaba-dependencies BOM 管理（2025.0.0.0）。
-->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
    </dependencies>
</project>
