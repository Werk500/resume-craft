# ===== AI 模型（OpenAI 兼容协议；不填 AI_API_KEY 时使用 Mock 实现） =====
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ===== Embedding（阿里云百炼 text-embedding-v3，1024 维）=====
# 留空时 EmbeddingService 走 Noop 实现，语义分自动降级为 AI 近似打分
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# ===== pgvector（PostgreSQL 向量库）=====
# 初始化：psql -U postgres -c "CREATE DATABASE resume_craft_vector"
#         psql -U postgres -d resume_craft_vector -f apps/server/db/pgvector_schema.sql
PG_URL=jdbc:postgresql://localhost:5432/resume_craft_vector
PG_USER=postgres
PG_PASSWORD=

# ===== 安全 =====
# JWT 签名密钥，生产环境务必替换为随机生成的 32 字节以上字符串
JWT_SECRET=dev-only-secret-key-change-before-prod-32bytes
# 服务间内部调用令牌（Feign 请求头 X-Internal-Token）
INTERNAL_TOKEN=dev-internal-token

# ===== 中间件（默认值可省略，仅在与默认不同时覆盖） =====
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456
NACOS_ADDR=localhost:8848
